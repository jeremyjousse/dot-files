				{ "action": "shell", "resource": "oxlint *", "effect": "allow" },
				{ "action": "shell", "resource": "oxfmt *", "effect": "allow" },
				{ "action": "shell", "resource": "prettier *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk prettier *", "effect": "allow" },
				{ "action": "shell", "resource": "rg *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk rg *", "effect": "allow" },
				{ "action": "shell", "resource": "grep *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk grep *", "effect": "allow" },
				{ "action": "shell", "resource": "cat *", "effect": "allow" },
				{ "action": "shell", "resource": "which *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk which *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk gain *", "effect": "allow" },
			],
		},
