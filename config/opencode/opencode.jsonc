				{ "action": "shell", "resource": "git show *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk git show *", "effect": "allow" },
				{ "action": "shell", "resource": "git branch *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk git branch *", "effect": "allow" },
				{ "action": "shell", "resource": "git add *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk git add *", "effect": "allow" },
				{ "action": "shell", "resource": "git worktree *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk git worktree *", "effect": "allow" },
				{ "action": "shell", "resource": "gh issue *", "effect": "allow" },
