{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["~/.agents/rules/sdlc-framework.md"],
	"mcp": {
		"codeburn": {
			"type": "local",
			"command": ["codeburn", "mcp"],
			"enabled": true,
		},
	},
	"permission": {
		"bash": {
			"*": "ask",
			"codeburn status *": "allow",
			"rtk codeburn status *": "allow",
			"gh issue *": "allow",
			"rtk gh issue *": "allow",
			"gh label list *": "allow",
			"rtk gh label list *": "allow",
			"gh repo view *": "allow",
			"rtk gh repo view *": "allow",
			"git show *": "allow",
			"rtk git show *": "allow",
			"which *": "allow",
			"rtk which *": "allow",
		},
	},
	"agent": {
		"sdlc-refine": {
			"permission": {
				"edit": "deny",
				"task": "deny",
				"external_directory": "deny",
				"bash": {
					"*": "deny",
					"gh issue *": "allow",
					"rtk gh issue *": "allow",
					"gh label list *": "allow",
					"rtk gh label list *": "allow",
					"gh repo view *": "allow",
					"rtk gh repo view *": "allow",
					"rtk gain *": "allow",
				},
			},
		},
		"sdlc-develop": {
			"permission": {
				"edit": "allow",
				"task": "deny",
				"external_directory": "deny",
				"bash": {
					"*": "ask",
					"git status *": "allow",
					"rtk git status *": "allow",
					"git diff *": "allow",
					"rtk git diff *": "allow",
					"git log *": "allow",
					"rtk git log *": "allow",
					"git show *": "allow",
					"rtk git show *": "allow",
					"git branch *": "allow",
					"rtk git branch *": "allow",
					"git add *": "allow",
					"rtk git add *": "allow",
					"git worktree *": "allow",
					"rtk git worktree *": "allow",
					"gh issue *": "allow",
					"rtk gh issue *": "allow",
					"gh label list *": "allow",
					"rtk gh label list *": "allow",
					"gh repo view *": "allow",
					"rtk gh repo view *": "allow",
					"cargo *": "allow",
					"rtk cargo *": "allow",
					"pnpm *": "allow",
					"rtk pnpm *": "allow",
					"npm *": "allow",
					"rtk npm *": "allow",
					"yarn *": "allow",
					"bun *": "allow",
					"rtk bun *": "allow",
					"mise *": "allow",
					"rtk mise *": "allow",
					"xcodegen *": "allow",
					"xcodebuild *": "allow",
					"oxlint *": "allow",
					"oxfmt *": "allow",
					"prettier *": "allow",
					"rtk prettier *": "allow",
					"rg *": "allow",
					"rtk rg *": "allow",
					"grep *": "allow",
					"rtk grep *": "allow",
					"cat *": "allow",
					"which *": "allow",
					"rtk which *": "allow",
					"rtk gain *": "allow",
				},
			},
		},
		"sdlc-verify": {
			"permission": {
				"edit": "deny",
				"task": "deny",
				"external_directory": "deny",
				"bash": {
					"*": "deny",
					"gh issue *": "allow",
					"rtk gh issue *": "allow",
					"git status *": "allow",
					"rtk git status *": "allow",
					"git diff *": "allow",
					"rtk git diff *": "allow",
					"git log *": "allow",
					"rtk git log *": "allow",
					"git show *": "allow",
					"rtk git show *": "allow",
					"git branch *": "allow",
					"rtk git branch *": "allow",
					"cargo *": "allow",
					"rtk cargo *": "allow",
					"pnpm *": "allow",
					"rtk pnpm *": "allow",
					"npm *": "allow",
					"rtk npm *": "allow",
					"yarn *": "allow",
					"bun *": "allow",
					"rtk bun *": "allow",
					"mise *": "allow",
					"rtk mise *": "allow",
					"xcodegen *": "allow",
					"xcodebuild *": "allow",
					"oxlint *": "allow",
					"oxfmt *": "allow",
					"prettier *": "allow",
					"rtk prettier *": "allow",
					"rg *": "allow",
					"rtk rg *": "allow",
					"grep *": "allow",
					"rtk grep *": "allow",
					"which *": "allow",
					"rtk which *": "allow",
					"rtk gain *": "allow",
				},
			},
		},
		"sdlc-pr-review": {
			"permission": {
				"edit": "allow",
				"task": "deny",
				"external_directory": "deny",
				"bash": {
					"*": "ask",
					"gh pr *": "allow",
					"rtk gh pr *": "allow",
					"gh repo view *": "allow",
					"rtk gh repo view *": "allow",
					"gh issue *": "allow",
					"rtk gh issue *": "allow",
					"gh pr merge *": "deny",
					"rtk gh pr merge *": "deny",
					"gh api *": "allow",
					"rtk gh api *": "allow",
					"sleep *": "allow",
					"cat *": "allow",
					"git status *": "allow",
					"rtk git status *": "allow",
					"git diff *": "allow",
					"rtk git diff *": "allow",
					"git log *": "allow",
					"rtk git log *": "allow",
					"git show *": "allow",
					"rtk git show *": "allow",
					"git branch *": "allow",
					"rtk git branch *": "allow",
					"git push *": "allow",
					"rtk git push *": "allow",
					"cargo *": "allow",
					"rtk cargo *": "allow",
					"pnpm *": "allow",
					"rtk pnpm *": "allow",
					"npm *": "allow",
					"rtk npm *": "allow",
					"yarn *": "allow",
					"bun *": "allow",
					"rtk bun *": "allow",
					"mise *": "allow",
					"rtk mise *": "allow",
					"xcodegen *": "allow",
					"xcodebuild *": "allow",
					"rg *": "allow",
					"rtk rg *": "allow",
					"which *": "allow",
					"rtk which *": "allow",
					"rtk gain *": "allow",
				},
			},
		},
	},
}
