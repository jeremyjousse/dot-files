				{ "action": "shell", "resource": "rtk gh issue *", "effect": "allow" },
				{ "action": "shell", "resource": "gh pr merge *", "effect": "deny" },
				{ "action": "shell", "resource": "rtk gh pr merge *", "effect": "deny" },
				{ "action": "shell", "resource": "gh api *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk gh api *", "effect": "allow" },
				{ "action": "shell", "resource": "sleep *", "effect": "allow" },
