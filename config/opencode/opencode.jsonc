				{ "action": "shell", "resource": "pnpm *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk pnpm *", "effect": "allow" },
				{ "action": "shell", "resource": "npm *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk npm *", "effect": "allow" },
				{ "action": "shell", "resource": "yarn *", "effect": "allow" },
				{ "action": "shell", "resource": "bun *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk bun *", "effect": "allow" },
				{ "action": "shell", "resource": "mise *", "effect": "allow" },
				{ "action": "shell", "resource": "rtk mise *", "effect": "allow" },
				{ "action": "shell", "resource": "xcodegen *", "effect": "allow" },
